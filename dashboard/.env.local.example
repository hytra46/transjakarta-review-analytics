# Salin menjadi .env.local untuk menjalankan di komputer.
# Nilai yang sama juga diisikan di Vercel, menu Settings > Environment Variables.

# Awalan NEXT_PUBLIC_ berarti nilainya ikut terkirim ke browser.
# Itu aman untuk anon key, karena Row Level Security hanya mengizinkan SELECT.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# TANPA awalan NEXT_PUBLIC_, jadi alamat Space hanya dikenal server.
PLAYGROUND_API_URL=https://USERNAME-indobert-tj-playground.hf.space
